[Unit]
Description=Collect new AI briefs and notify the configured WeCom group
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=enterprise-cases
Group=enterprise-cases
WorkingDirectory=/opt/enterprise-cases/current
EnvironmentFile=/etc/enterprise-cases.env
ExecStart=/opt/enterprise-cases/runtime/pnpm/bin/pnpm.cjs monitor:service
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/enterprise-cases
Slice=enterprise-cases.slice
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=0
CPUQuota=30%
Nice=15
TasksMax=64
