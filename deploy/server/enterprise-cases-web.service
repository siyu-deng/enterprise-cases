[Unit]
Description=Enterprise AI briefs web
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=enterprise-cases
Group=enterprise-cases
WorkingDirectory=/opt/enterprise-cases/current
EnvironmentFile=/etc/enterprise-cases.env
ExecStart=/opt/enterprise-cases/runtime/pnpm/bin/pnpm.cjs exec node server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/enterprise-cases /opt/enterprise-cases/current/.next/cache
Slice=enterprise-cases.slice
MemoryHigh=256M
MemoryMax=384M
MemorySwapMax=0
CPUQuota=60%
Nice=10
TasksMax=80

[Install]
WantedBy=multi-user.target
